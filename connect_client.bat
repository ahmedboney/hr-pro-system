@echo off
chcp 65001 >nul
title HR Pro System - جهاز فرع / جهاز عميل
echo ============================================================
echo  HR Pro - اتصال من جهاز عميل (فرع / موظف)
echo  يفتح لك النظام على جهاز السيرفر الرئيسي
echo ============================================================
echo.

set SRV=
set /p SRV=ادخل عنوان الجهاز الرئيسي (مثل 192.168.1.10):

if "%SRV%"=="" (
  echo [x] لم يُدخل عنوان - سيُستخدم 127.0.0.1
  set SRV=127.0.0.1
)

set PRT=
set /p PRT=ادخل المنفذ إذا كان مختلفاً (اتركه فارغاً = 8080):
if "%PRT%"=="" set PRT=8080

echo.
echo [+] فتح http://%SRV%:%PRT% ...
start "" "http://%SRV%:%PRT%"

echo.
echo  خطوات سريعة بعد الفتح:
echo  1- تسجيل الدخول بالحساب الذي أنشأه لك المدير.
echo  2- الحضور والانصراف، التقارير، الشهادات، كلها من المتصفح.
echo.
if not "%1"=="--nopause" pause